# Development/Local: Use :80 (HTTP only)
# Production: Replace with your domain for automatic HTTPS
:80 {
    # Serve static files
    root * /srv
    
    # Enable compression
    encode gzip zstd
    
    # SPA routing - try files, fallback to index.html
    try_files {path} /index.html
    
    # Serve files
    file_server
    
    # Cache static assets
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}
